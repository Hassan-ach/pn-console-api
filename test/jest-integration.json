{
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": "..",
    "testRegex": ".*\\.integration\\.spec\\.ts$",
    "transform": {
        "^.+\\.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node",
    "moduleNameMapper": {
        "^src/(.*)$": "<rootDir>/src/$1",
        "^generated/(.*)$": "<rootDir>/generated/$1"
    }
}
