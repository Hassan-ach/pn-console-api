{
    "name": "pn-console-api",
    "version": "0.0.1",
    "description": "",
    "author": "",
    "private": true,
    "license": "UNLICENSED",
    "scripts": {
        "build": "nest build",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/main",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "test": "jest",
        "test:integration": "jest --config ./test/jest-integration.json",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "test:e2e": "jest --config ./test/jest-e2e.json",
        "prisma:generate": "prisma generate --schema=prisma/raw-db/schema.prisma && prisma generate --schema=prisma/app-db/schema.prisma",
        "prisma:push": "prisma db push --schema=prisma/raw-db/schema.prisma && prisma db push --schema=prisma/app-db/schema.prisma && tsx prisma/app-db/init-vector.ts",
        "prisma:seed": "tsx prisma/app-db/seed.ts",
        "db:setup": "pnpm prisma:push && pnpm prisma:generate && pnpm prisma:seed"
    },
    "dependencies": {
        "@langchain/anthropic": "^1.5.1",
        "@langchain/community": "^1.1.29",
        "@langchain/core": "^1.2.1",
        "@langchain/deepseek": "^1.1.5",
        "@langchain/google-genai": "^2.2.0",
        "@langchain/ollama": "^1.3.0",
        "@langchain/openai": "^1.5.3",
        "@langchain/xai": "^1.4.3",
        "@nestjs-modules/mailer": "^2.3.7",
        "@nestjs/common": "^11.0.1",
        "@nestjs/config": "^4.0.4",
        "@nestjs/core": "^11.0.1",
        "@nestjs/event-emitter": "^3.1.0",
        "@nestjs/jwt": "^11.0.2",
        "@nestjs/passport": "^11.0.5",
        "@nestjs/platform-express": "^11.0.1",
        "@nestjs/swagger": "^11.4.5",
        "@prisma/client": "^6.19.3",
        "bcrypt": "^6.0.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.15.1",
        "express-session": "^1.19.0",
        "fastest-levenshtein": "^1.0.16",
        "langchain": "^1.5.2",
        "neo4j-driver": "^6.2.0",
        "nodemailer": "^9.0.3",
        "passport": "^0.7.0",
        "passport-google-oauth20": "^2.0.0",
        "passport-jwt": "^4.0.1",
        "passport-microsoft": "^2.1.0",
        "passport-openidconnect": "^0.1.2",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1",
        "telegram": "^2.26.22",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.2.0",
        "@eslint/js": "^9.18.0",
        "@nestjs/cli": "^11.0.0",
        "@nestjs/schematics": "^11.0.0",
        "@nestjs/testing": "^11.0.1",
        "@types/bcrypt": "^6.0.0",
        "@types/express": "^5.0.0",
        "@types/express-session": "^1.19.0",
        "@types/jest": "^30.0.0",
        "@types/node": "^24.0.0",
        "@types/nodemailer": "^8.0.1",
        "@types/passport": "^1.0.17",
        "@types/passport-google-oauth20": "^2.0.17",
        "@types/passport-jwt": "^4.0.1",
        "@types/passport-microsoft": "^2.1.1",
        "@types/passport-oauth2": "^1.8.0",
        "@types/passport-openidconnect": "^0.1.3",
        "@types/supertest": "^7.0.0",
        "eslint": "^9.18.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-plugin-prettier": "^5.2.2",
        "globals": "^17.0.0",
        "jest": "^30.0.0",
        "prettier": "^3.4.2",
        "prisma": "^6.19.3",
        "source-map-support": "^0.5.21",
        "supertest": "^7.0.0",
        "ts-jest": "^29.2.5",
        "ts-loader": "^9.5.2",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "tsx": "^4.23.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.20.0"
    },
    "prisma": {
        "seed": "tsx prisma/app-db/seed.ts"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "testPathIgnorePatterns": [
            "\\.integration\\.spec\\.ts$"
        ],
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node",
        "moduleNameMapper": {
            "^src/(.*)$": "<rootDir>/$1",
            "^generated/(.*)$": "<rootDir>/../generated/$1"
        }
    }
}
