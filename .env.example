# ============================================
# App / Server
# ============================================
PORT=3000                                # number (default: 3000)

# ============================================
# Frontend
# ============================================
FRONTEND_URL=http://localhost:1420       # string (default: http://localhost:1420)

# ============================================
# Database
# ============================================
DATABASE_URL=postgres://pn_console:pn_console@localhost:5432/np_console_raw_db    # string (required)
APP_DATABASE_URL=postgresql://pn_console:pn_console@localhost:5432/np_console_app_db # string (required)
NEO4J_URI=bolt://localhost:7687          # string (default: bolt://localhost:7687)
NEO4J_USER=neo4j                         # string (default: neo4j)
NEO4J_PASSWORD=pn_console_password       # string (default: pn_console_password)


# ============================================
# JWT
# ============================================
JWT_SECRET=your-secret-key-here          # string (required)

# ============================================
# Redis (multi-instance coordination)
# ============================================
REDIS_URL=redis://localhost:6379         # string (default: redis://localhost:6379)
JWT_EXPIRATION=7d                        # string (default: 7d)

# ============================================
# LLM / Intelligence
# ============================================
LLM_PROVIDER=                            # string: openai|anthropic|ollama|google-genai|xai
LLM_MODEL=                               # string
LLM_API_KEY=                             # string (not required for ollama)
LLM_BASE_URL=                            # string (required when LLM_PROVIDER=ollama)
LLM_MAX_RETRIES=3                        # number (default: 3)
OWNER_RESOLVER_MAX_DISTANCE=3            # number (default: 3)

# ============================================
# Embeddings (RAG)
# ============================================
EMBEDDING_PROVIDER=openai                # string: openai|ollama|google-genai (default: openai)
EMBEDDING_MODEL=text-embedding-3-small   # string (default: text-embedding-3-small)
EMBEDDING_DIMENSIONS=1536                # number (default: 1536; use 768 for ollama nomic-embed-text)
EMBEDDING_BASE_URL=http://localhost:11434 # string (default: http://localhost:11434; only used for ollama)
EMBEDDING_API_KEY=                       # string (defaults to LLM_API_KEY if empty)

# ============================================
# OAuth — Google
# ============================================
GOOGLE_CLIENT_ID=                        # string
GOOGLE_CLIENT_SECRET=                    # string
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback # string

# ============================================
# OAuth — Microsoft
# ============================================
MICROSOFT_CLIENT_ID=                     # string
MICROSOFT_CLIENT_SECRET=                 # string
MICROSOFT_CALLBACK_URL=http://localhost:3000/api/auth/microsoft/callback # string

# ============================================
# OAuth — SSO (Keycloak)
# ============================================
SSO_ISSUER=http://localhost:8080/realms/company                              # string (uri)
SSO_AUTHORIZATION_URL=http://localhost:8080/realms/company/protocol/openid-connect/auth  # string (uri)
SSO_TOKEN_URL=http://localhost:8080/realms/company/protocol/openid-connect/token         # string (uri)
SSO_USERINFO_URL=http://localhost:8080/realms/company/protocol/openid-connect/userinfo   # string (uri)
SSO_CLIENT_ID=                           # string
SSO_CLIENT_SECRET=                       # string
SSO_CALLBACK_URL=http://localhost:3000/api/auth/sso/callback                 # string

# ============================================
# SMTP / Mail
# ============================================
SMTP_HOST=localhost                      # string (default: localhost)
SMTP_PORT=1025                           # number (default: 1025)
SMTP_USER=                               # string (optional)
SMTP_PASS=                               # string (optional)
SMTP_FROM=noreply@mosaid.com             # string (default: noreply@mosaid.com)
