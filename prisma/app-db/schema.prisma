generator client {
  provider = "prisma-client-js"
  output   = "../../generated/app-db-client"
}

datasource db {
  provider = "postgresql"
  url      = env("APP_DATABASE_URL")
}

model Insight {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String?          @map("organization_id")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  versions       InsightVersion[]

  @@index([organizationId])
  @@map("insights")
}

model InsightVersion {
  id               String                @id @default(uuid()) @db.Uuid
  insightId        String                @db.Uuid
  version          Int
  type             InsightType
  content          String
  owners           InsightVersionOwner[]
  unresolvedOwners UnresolvedOwner[]
  broadcasted      Boolean               @default(false)
  envolopsRef      String[]              @default([])

  sourcePlugin String? @map("source_plugin")
  groupId      String? @map("group_id")
  channelId    String? @map("channel_id")
  topicId      String? @map("topic_id")

  createdAt DateTime @default(now()) @map("created_at")
  insight   Insight  @relation(fields: [insightId], references: [id], onDelete: Cascade)

  @@unique([insightId, version])
  @@index([insightId])
  @@index([sourcePlugin, channelId, topicId, createdAt])
  @@index([sourcePlugin, groupId, createdAt])
  @@map("insight_versions")
}

model InsightVersionOwner {
  id               String              @id @default(uuid()) @db.Uuid
  insightVersionId String              @map("insight_version_id") @db.Uuid
  userId           String              @map("user_id") @db.Uuid
  status           InsightActionStatus @default(PENDING)
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  insightVersion InsightVersion @relation(fields: [insightVersionId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([insightVersionId, userId])
  @@index([insightVersionId])
  @@index([userId])
  @@map("insight_version_owners")
}

enum ProviderType {
  EMAIL
  GOOGLE
  MICROSOFT
  SSO
}

model User {
  id                  String                @id @default(uuid()) @db.Uuid
  firstName           String                @map("first_name")
  lastName            String?               @map("last_name")
  email               String
  passwordHash        String?               @map("password_hash")
  providerType        ProviderType          @default(EMAIL) @map("provider_type")
  tokenVersion        Int                   @default(0) @map("token_version")
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")
  platformMappings    PlatformUserMapping[]
  insightOwnerships   InsightVersionOwner[]
  passwordResetTokens PasswordResetToken[]
  chatMessages        ChatMessage[]

  @@unique([email, providerType])
  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  token     String    @unique
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at")
  relayedAt DateTime? @map("relayed_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model PlatformUserMapping {
  id               String @id @default(uuid()) @db.Uuid
  platformUserId   String @map("platform_user_id")
  appUserId        String @map("app_user_id") @db.Uuid
  pluginName       String @map("plugin_name")
  platformUsername String @map("platform_username")

  user User @relation(fields: [appUserId], references: [id], onDelete: Cascade)

  @@unique([platformUserId, pluginName])
  @@index([appUserId])
  @@map("platform_user_mappings")
}

enum InsightType {
  TASK
  INFO
  URGENCY
  DECISION
}

enum InsightActionStatus {
  PENDING
  NOTED
  DONE
  BLOCKED
  IN_REVIEW
  DECIDED
  DELEGATED
  DELAYED
  HIDDEN
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum PluginStatus {
  NOT_CONNECTED
  CONNECTED
  CONFIGURED
  ACTIVATING
  ACTIVE
  DEACTIVATING
  ERROR
}

enum ChatRole {
  USER
  ASSISTANT
}

model UnresolvedOwner {
  id               String         @id @default(uuid()) @db.Uuid
  platformUserId   String?        @map("platform_user_id")
  platformUsername String?        @map("platform_username")
  pluginName       String         @map("plugin_name")
  insightVersionId String         @map("insight_version_id") @db.Uuid
  insightVersion   InsightVersion @relation(fields: [insightVersionId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now()) @map("created_at")

  @@index([insightVersionId])
  @@index([pluginName, platformUserId])
  @@map("unresolved_owners")
}

model PluginConfig {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String?      @map("organization_id")
  userId         String       @map("user_id")
  pluginName     String       @map("plugin_name")
  sessionString  String?      @map("session_string")
  config         Json         @map("config")
  metadata       Json?        @map("metadata")

  status         PluginStatus @default(NOT_CONNECTED)
  activatedAt    DateTime?    @map("activated_at")
  errorMessage   String?      @map("error_message")

  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@unique([userId, pluginName])
  @@index([organizationId])
  @@index([userId])
  @@index([pluginName])
  @@map("plugin_configs")
}

model ActiveChatListener {
  id              String   @id @default(uuid()) @db.Uuid
  pluginName      String   @map("plugin_name")
  chatId          String   @map("chat_id")
  organizationId  String   @map("organization_id")
  ownerUserId     String   @map("owner_user_id")
  subscriberCount Int      @default(1)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([pluginName, chatId])
  @@map("active_chat_listeners")
}

model Job {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String?   @map("user_id") @db.Uuid
  organizationId String?   @map("organization_id")
  title          String
  description    String?
  progressable   Boolean   @default(false)
  progress       Int?
  message        String?
  status         JobStatus @default(PENDING)
  startedAt      DateTime? @map("started_at") @db.Timestamptz
  completedAt    DateTime? @map("completed_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@index([userId])
  @@index([organizationId])
  @@index([status])
  @@map("jobs")
}

model ChatMessage {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      ChatRole
  content   String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("chat_messages")
}
