generator client {
  provider = "prisma-client-js"
  output   = "../../generated/app-db-client"
}

datasource db {
  provider = "postgresql"
  url      = env("APP_DATABASE_URL")
}

model Insight {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String?             @map("organization_id")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  versions       InsightVersion[]
  suggestions    InsightSuggestion[]

  @@index([organizationId])
  @@map("insights")
}

model InsightVersion {
    id               String                @id @default(uuid()) @db.Uuid
    insightId        String                @db.Uuid
    version          Int
    type             InsightType
    content          String
    owners           InsightVersionOwner[]
    unresolvedOwners UnresolvedOwner[]
    broadcasted      Boolean               @default(false)
    envolopsRef      String[]              @default([])

    sourcePlugin String?   @map("source_plugin")
    groupId      String?   @map("group_id")
    channelId    String?   @map("channel_id")
    topicId      String?   @map("topic_id")
    deadline     DateTime? @map("deadline")
    embedding    Unsupported("vector(1536)")?

    createdAt DateTime @default(now()) @map("created_at")
    insight   Insight  @relation(fields: [insightId], references: [id], onDelete: Cascade)

  @@unique([insightId, version])
  @@index([insightId])
  @@index([sourcePlugin, channelId, topicId, createdAt])
  @@index([sourcePlugin, groupId, createdAt])
  @@map("insight_versions")
}

model InsightVersionOwner {
  id               String              @id @default(uuid()) @db.Uuid
  insightVersionId String              @map("insight_version_id") @db.Uuid
  userId           String              @map("user_id") @db.Uuid
  status           InsightActionStatus @default(PENDING)
  priority         Int?                @map("priority")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  insightVersion InsightVersion @relation(fields: [insightVersionId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([insightVersionId, userId])
  @@index([insightVersionId])
  @@index([userId])
  @@map("insight_version_owners")
}

enum ProviderType {
  EMAIL
  GOOGLE
  MICROSOFT
  SSO
}

model User {
  id                  String                @id @default(uuid()) @db.Uuid
  organizationId      String?               @map("organization_id")
  firstName           String                @map("first_name")
  lastName            String?               @map("last_name")
  email               String
  passwordHash        String?               @map("password_hash")
  providerType        ProviderType          @default(EMAIL) @map("provider_type")
  tokenVersion        Int                   @default(0) @map("token_version")
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")
  platformMappings    PlatformUserMapping[]
  insightOwnerships   InsightVersionOwner[]
  passwordResetTokens PasswordResetToken[]
    chatMessages        ChatMessage[]
    conversations       Conversation[]


  @@unique([email, providerType])
  @@index([organizationId])
  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  token     String    @unique
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at")
  relayedAt DateTime? @map("relayed_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model PlatformUserMapping {
  id               String @id @default(uuid()) @db.Uuid
  platformUserId   String @map("platform_user_id")
  appUserId        String @map("app_user_id") @db.Uuid
  pluginName       String @map("plugin_name")
  platformUsername String @map("platform_username")

  user User @relation(fields: [appUserId], references: [id], onDelete: Cascade)

  @@unique([platformUserId, pluginName])
  @@index([appUserId])
  @@map("platform_user_mappings")
}

enum InsightType {
  TASK
  INFO
  URGENCY
  DECISION
}

enum InsightActionStatus {
  PENDING
  NOTED
  DONE
  BLOCKED
  IN_REVIEW
  DECIDED
  DELEGATED
  DELAYED
  HIDDEN
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum PluginStatus {
  NOT_CONNECTED
  CONNECTED
  CONFIGURED
  ACTIVATING
  ACTIVE
  DEACTIVATING
  ERROR
}

enum ChatRole {
  USER
  ASSISTANT
}

model UnresolvedOwner {
  id               String         @id @default(uuid()) @db.Uuid
  platformUserId   String?        @map("platform_user_id")
  platformUsername String?        @map("platform_username")
  pluginName       String         @map("plugin_name")
  insightVersionId String         @map("insight_version_id") @db.Uuid
  insightVersion   InsightVersion @relation(fields: [insightVersionId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now()) @map("created_at")

  @@index([insightVersionId])
  @@index([pluginName, platformUserId])
  @@map("unresolved_owners")
}

model PluginConfig {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String?      @map("organization_id")
  userId         String       @map("user_id")
  pluginName     String       @map("plugin_name")
  sessionString  String?      @map("session_string")
  config         Json         @map("config")
  metadata       Json?        @map("metadata")

  status         PluginStatus @default(NOT_CONNECTED)
  activatedAt    DateTime?    @map("activated_at")
  errorMessage   String?      @map("error_message")

  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@unique([userId, pluginName])
  @@index([organizationId])
  @@index([userId])
  @@index([pluginName])
  @@map("plugin_configs")
}

model ActiveChatListener {
  id              String    @id @default(uuid()) @db.Uuid
  pluginName      String    @map("plugin_name")
  chatId          String    @map("chat_id")
  organizationId  String    @map("organization_id")
  ownerUserId     String    @map("owner_user_id")
  subscriberCount Int       @default(1)
  claimedBy       String?   @map("claimed_by")
  heartbeatAt     DateTime? @map("heartbeat_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@unique([pluginName, chatId])
  @@map("active_chat_listeners")
}

model Job {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String?   @map("user_id") @db.Uuid
  organizationId String?   @map("organization_id")
  title          String
  description    String?
  progressable   Boolean   @default(false)
  progress       Int?
  message        String?
  status         JobStatus @default(PENDING)
  startedAt      DateTime? @map("started_at") @db.Timestamptz
  completedAt    DateTime? @map("completed_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@index([userId])
  @@index([organizationId])
  @@index([status])
  @@map("jobs")
}

model Conversation {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  title     String        @default("New chat")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  messages ChatMessage[]
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@map("conversations")
}

model ChatMessage {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  conversationId String?      @map("conversation_id") @db.Uuid
  role           ChatRole
  content        String
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz

  conversation  Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([conversationId, createdAt])
  @@map("chat_messages")
}

enum SuggestionActionType {
  RECOMMENDATION
  RISK_MITIGATION
  NEXT_STEP
}

enum SuggestionStatus {
  PENDING
  ACCEPTED
  DISMISSED
  COMPLETED
}

model Entity {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("organization_id")
  name           String
  type           String
  metadata       Json?    @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  sourceRelationships Relationship[] @relation("SourceEntity")
  targetRelationships Relationship[] @relation("TargetEntity")

  @@index([organizationId])
  @@index([type])
  @@index([name])
  @@index([organizationId, type, name])
  @@map("entities")
}

model Relationship {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("organization_id")
  sourceEntityId String   @map("source_entity_id") @db.Uuid
  targetEntityId String   @map("target_entity_id") @db.Uuid
  type           String
  metadata       Json?    @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  sourceEntity Entity @relation("SourceEntity", fields: [sourceEntityId], references: [id], onDelete: Cascade)
  targetEntity Entity @relation("TargetEntity", fields: [targetEntityId], references: [id], onDelete: Cascade)

  @@unique([sourceEntityId, targetEntityId, type])
  @@index([sourceEntityId])
  @@index([targetEntityId])
  @@index([organizationId])
  @@map("relationships")
}

model InsightSuggestion {
  id             String               @id @default(uuid()) @db.Uuid
  insightId      String               @map("insight_id") @db.Uuid
  organizationId String?              @map("organization_id")
  title          String
  description    String
  actionType     SuggestionActionType @default(RECOMMENDATION) @map("action_type")
  reasoning      String?
  status         SuggestionStatus     @default(PENDING)
  metadata       Json?                @default("{}")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  insight Insight @relation(fields: [insightId], references: [id], onDelete: Cascade)

  @@index([insightId])
  @@index([organizationId])
  @@index([status])
  @@map("insight_suggestions")
}

