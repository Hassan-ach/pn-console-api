generator client {
  provider = "prisma-client-js"
  output   = "../../generated/raw-db-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EnvelopeType {
  message
}

enum IngestionStatus {
  PENDING
  READY
  FAILED
}

enum MessagePayloadType {
  direct
  email
}

model MessagePayload {
  id         String             @id @default(uuid()) @db.Uuid
  type       MessagePayloadType
  content    String
  groupId    String?            @map("group_id")
  channelId  String?            @map("channel_id")
  replyTo    String?            @map("reply_to")
  topicId    String?            @map("topic_id")
  reactions  Json               @default("{}")
  pinned     Boolean            @default(false)
  editedDate DateTime?          @map("edited_date") @db.Timestamptz
  entities   Json?
  rawPayload Json               @map("raw_payload")
  envelopes  Envelope[]

  @@map("message_payload")
}

model Envelope {
  id             String          @id @default(uuid()) @db.Uuid
  sourcePlugin   String          @map("source_plugin")
  sourceId       String          @map("source_id")
  type           EnvelopeType
  payloadRef     String          @map("payload_ref") @db.Uuid
  hasAttachment  Boolean         @default(false) @map("has_attachment")
  authorId       String?         @map("author_id")
  organizationId String?         @map("organization_id")
  occurredAt     DateTime        @map("occurred_at") @db.Timestamptz
  ingestedAt     DateTime        @default(now()) @map("ingested_at") @db.Timestamptz
  status         IngestionStatus @default(PENDING)
  permissions    Json            @default("{}")
  payload        MessagePayload  @relation(fields: [payloadRef], references: [id])

  @@unique([sourcePlugin, sourceId])
  @@map("envelope")
}

model PluginCursor {
  id         String   @id @default(uuid()) @db.Uuid
  pluginName String   @map("plugin_name")
  userId     String   @map("user_id")
  key        String
  value      BigInt
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([pluginName, userId, key])
  @@map("plugin_cursor")
}

model CapabilityFailure {
  id             String   @id @default(uuid()) @db.Uuid
  capabilityName String   @map("capability_name")
  chunkId        String   @map("chunk_id")
  errorMessage   String   @map("error_message")
  envelopeIds    String[] @default([]) @map("envelope_ids")
  organizationId String   @map("organization_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  resolved       Boolean  @default(false)

  @@index([organizationId, capabilityName])
  @@index([resolved])
  @@map("capability_failures")
}
